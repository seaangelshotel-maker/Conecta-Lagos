# ============================================================
# Lagos GO — variáveis de ambiente
# Copie para .env (local) ou cadastre na Vercel (Settings > Environment Variables).
# Nunca faça commit do .env com valores reais.
# ============================================================

# --- Navegador (opcional; o padrão é o projeto Firebase conectario-dd04b) ---
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=

# --- Servidor (funções /api) ---
# URL pública do site, sem barra no final (ex.: https://lagosgo.com.br)
APP_URL=
# JSON completo da conta de serviço do Firebase (uma linha). Necessário para /api/ai e pagamentos.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=conectario-dd04b

# --- IA (somente servidor; nunca use prefixo VITE_) ---
GEMINI_API_KEY=

# --- Pagamentos (desativados por padrão) ---
PAYMENTS_ENABLED=false
PAGBANK_ENV=sandbox
PAGBANK_TOKEN=
